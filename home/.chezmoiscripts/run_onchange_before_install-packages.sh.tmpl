{{ if not .isWindows -}}
#!/bin/bash
# Installs everything in .packages (which atm is built from .chezmoidata/packages.yml) via brew bundle.
# Reruns when the rendered list changes.
set -euo pipefail

# Failsafe if current shell hasn't loaded brew yet. 
if ! command -v brew >/dev/null; then
  for brew_path in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_path" ]; then
      eval "$("$brew_path" shellenv)"
      break
    fi
  done
fi

if ! command -v brew >/dev/null; then
  echo "Homebrew not found. Install it first (see README)." >&2
  exit 1
fi

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ if .isPersonal -}}
{{ range .packages.personalBrews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
{{ if eq .chezmoi.os "darwin" -}}

# A blocked or failed GUI app only warns, so it doesn't stop the apply.
brew bundle --file=/dev/stdin <<EOF || echo "Warning: some casks failed to install." >&2
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
{{ end -}}
