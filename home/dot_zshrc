# Managed by chezmoi (VoidUnderflow/dotfiles). Machine-specific config goes in ~/.zshrc.local.

# Homebrew (Mac or Linux path, whichever exists)
for brew_path in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $brew_path ]]; then
    eval "$($brew_path shellenv)"
    break
  fi
done

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 7
zstyle ':omz:update' cooldown 10

plugins=(git)

source "$ZSH/oh-my-zsh.sh"

[[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Must stay last: it wraps every widget defined before it.
[[ -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
